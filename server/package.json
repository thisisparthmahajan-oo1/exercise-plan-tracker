{
  "name": "fitness-sync-server",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/local.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/src/local.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts && npm run test:client",
    "test:client": "tsx --tsconfig test/client/tsconfig.json --test test/client/*.test.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "mongodb": "^7.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/sql.js": "^1.4.11",
    "mongodb-memory-server": "^11.3.0",
    "sql.js": "^1.15.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  }
}
